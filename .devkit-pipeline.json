{
  "version": 1,
  "remote": "origin",
  "reviewer": "codex",
  "timeout": 1200,
  "artifacts": ["dist/development-tools-kit.vsix", "dist/pipeline-configurator-0.2.0.zip"],
  "commands": {
    "prepare": [["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"]],
    "architecture": [["{python}", "scripts/architecture.py"], ["node", "scripts/check.js"]],
    "unit": [["node", "--test", "tests/text-tools.test.js"], ["{python}", "-m", "unittest", "discover", "-s", "tests/pipeline", "-p", "test_unit.py"]],
    "function": [["node", "--test", "tests/api.test.js"], ["{python}", "-m", "unittest", "discover", "-s", "tests/pipeline", "-p", "test_function.py"]],
    "integration": [["node", "--test", "tests/cli.test.js", "tests/git-compare.test.js", "tests/text-cli.test.js"], ["{python}", "-m", "unittest", "discover", "-s", "tests/pipeline", "-p", "test_integration.py"]],
    "build": [["{python}", "scripts/build.py"], ["npm", "exec", "--", "vsce", "package", "--no-dependencies", "--skip-license", "--out", "dist/development-tools-kit.vsix"]]
  }
}
