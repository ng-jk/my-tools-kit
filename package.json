{
  "name": "development-tools-kit",
  "displayName": "Development Tools Kit",
  "description": "API debugging, JSON formatting, text/file/Git comparison, and project-aware CI/CD configuration.",
  "version": "0.5.0",
  "publisher": "NGJUNKAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ng-jk/my-tools-kit.git"
  },
  "homepage": "https://github.com/ng-jk/my-tools-kit#readme",
  "bugs": {
    "url": "https://github.com/ng-jk/my-tools-kit/issues"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "main": "./extension.js",
  "bin": {
    "devkit": "./cli.js"
  },
  "scripts": {
    "test": "node --test tests/api.test.js tests/text-tools.test.js tests/cli.test.js tests/git-compare.test.js tests/text-cli.test.js",
    "test:interface": "node --test tests/extension.test.js tests/text-extension.test.js",
    "test:ui": "node --test tests/browser/*.test.js",
    "check": "node scripts/check.js",
    "build": "node pipeline-cli.js check .",
    "package": "vsce package --no-dependencies --out dist/development-tools-kit.vsix",
    "build:sftp": "node scripts/build-sftp.js",
    "vscode:prepublish": "node scripts/build-sftp.js",
    "test:sftp": "node scripts/build-sftp.js && node --test tests/sftp*.test.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onCommand:devkit.open",
    "onCommand:devkit.pipeline",
    "onCommand:devkit.textTools",
    "onCommand:devkit.jsonFormatter",
    "onCommand:devkit.compareFiles",
    "onCommand:devkit.compareGit",
    "onView:devkit.tools",
    "onView:devkit.remoteExplorer",
    "workspaceContains:.vscode/sftp.json"
  ],
  "contributes": {
    "configuration": {
      "title": "Development Tools Kit",
      "properties": {
        "devkit.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.11+ executable for the shared CI/CD runtime. Empty uses DEVKIT_PYTHON or py/python3."
        },
        "devkit.sftp.printDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on sftp output channel.(reload vscode when change this)"
        },
        "devkit.sftp.debug": {
          "type": "boolean",
          "default": false,
          "description": "print debug log on sftp output channel.(reload vscode when change this)"
        },
        "devkit.sftp.downloadWhenOpenInRemoteExplorer": {
          "type": "boolean",
          "default": false,
          "description": "\"Download\" instead of \"View Content\" when open file in Remote Explorer"
        }
      }
    },
    "commands": [
      {
        "command": "devkit.open",
        "title": "Development Tools Kit: Open API Debugger"
      },
      {
        "command": "devkit.pipeline",
        "title": "Development Tools Kit: Configure CI/CD"
      },
      {
        "command": "devkit.secret",
        "title": "Development Tools Kit: Store API Secret"
      },
      {
        "command": "devkit.textTools",
        "title": "Development Tools Kit: Compare Text / Open Text Tools"
      },
      {
        "command": "devkit.jsonFormatter",
        "title": "Development Tools Kit: Open JSON Formatter"
      },
      {
        "command": "devkit.formatJson",
        "title": "Development Tools Kit: Format JSON Document or Selection"
      },
      {
        "command": "devkit.compareFiles",
        "title": "Development Tools Kit: Compare Two Files"
      },
      {
        "command": "devkit.compareClipboard",
        "title": "Development Tools Kit: Compare Editor or Selection with Clipboard"
      },
      {
        "command": "devkit.compareGit",
        "title": "Development Tools Kit: Compare Git Revisions"
      },
      {
        "command": "devkit.sftp.config",
        "title": "Config",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.setProfile",
        "title": "Set Profile",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.openConnectInTerminal",
        "title": "Open SSH in Terminal",
        "category": "SFTP"
      },
      {
