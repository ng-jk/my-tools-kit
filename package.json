        "title": "Upload File",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.upload.changedFiles",
        "title": "Upload Changed Files",
        "category": "SFTP",
        "icon": {
          "light": "vendor/sftp/resources/light/upload.svg",
          "dark": "vendor/sftp/resources/dark/upload.svg"
        }
      },
      {
        "command": "devkit.sftp.upload.fileChanged",
        "title": "Upload File Changed (Pick Commit)",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.upload.activeFile",
        "title": "Upload Active File",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.upload.folder",
