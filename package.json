        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.upload.activeFolder",
        "title": "Upload Active Folder",
        "category": "SFTP"
      },
      {
        "command": "devkit.sftp.upload.project",
        "title": "Upload Project",
        "category": "SFTP"
      },
      {
